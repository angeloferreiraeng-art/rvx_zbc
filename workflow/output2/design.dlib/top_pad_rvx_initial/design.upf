# Implemented: supplies

set_design_attributes -elements . -internal_attribute _mv_data_file_version 1
set_design_attributes -elements . -attribute \
    enable_state_propagation_in_add_power_state false

## Start - load_upf /home/angelo.ferreira/FASE2/rvx_zbc/workflow/physical/power.upf on Mon Nov 23 20:28:19 2026
create_supply_net VSSCORE
create_supply_net VDDCORE
create_supply_net VDDPAD
create_supply_net VSSPAD

create_supply_set ss_low -function {power VDDCORE} -function {ground VSSCORE}
create_supply_set ss_high -function {power VDDPAD} -function {ground VSSPAD}

create_power_domain PD_TOP -supply {primary ss_low}

create_supply_port VDDCORE -direction in
create_supply_port VSSCORE -direction in
create_supply_port VDDPAD -direction in
create_supply_port VSSPAD -direction in

connect_supply_net VDDCORE -ports VDDCORE
connect_supply_net VSSCORE -ports VSSCORE
connect_supply_net VSSPAD -ports VSSPAD
connect_supply_net VDDPAD -ports VDDPAD

set_design_attributes -elements {.} -attribute correlated_supply_group {*}

add_power_state -supply ss_low -state ON  \
    { -supply_expr {power  == {FULL_ON 1.08 1.20 1.65} && \
                   ground == {FULL_ON 0.0}} }


add_power_state -supply ss_high -state ON  \
    { -supply_expr {power  == {FULL_ON 3.00 3.30 3.60} && \
                   ground == {FULL_ON 0.0}} }

create_power_state_group PST
add_power_state -group PST  \
    -state RUN { -logic_expr {ss_low==ON&&ss_high==ON} }
## End - load_upf /home/angelo.ferreira/FASE2/rvx_zbc/workflow/physical/power.upf
connect_supply_net VSSPAD -ports {VDD_0/VSSPAD VSS_0/VSSPAD IOVDD_0/VSSPAD IOVSS_0/VSSPAD IOVDD_1/VSSPAD IOVSS_1/VSSPAD VDD_2/VSSPAD VSS_2/VSSPAD IOVDD_2/VSSPAD IOVSS_2/VSSPAD IOVDD_3/VSSPAD IOVSS_3/VSSPAD PAD_CLK/VSSPAD PAD_RSTN/VSSPAD PAD_URX/VSSPAD PAD_MISO/VSSPAD PAD_UTX/VSSPAD PAD_SCLK/VSSPAD PAD_MOSI/VSSPAD PAD_CS/VSSPAD PAD_SDA/VSSPAD PAD_SCL/VSSPAD PAD_GPIO_0/VSSPAD PAD_GPIO_1/VSSPAD PAD_GPIO_2/VSSPAD PAD_GPIO_3/VSSPAD PAD_GPIO_4/VSSPAD PAD_GPIO_5/VSSPAD PAD_GPIO_6/VSSPAD PAD_GPIO_7/VSSPAD}
connect_supply_net VSSCORE -ports {VDD_0/VSSCORE VSS_0/VSSCORE IOVDD_0/VSSCORE IOVSS_0/VSSCORE IOVDD_1/VSSCORE IOVSS_1/VSSCORE VDD_2/VSSCORE VSS_2/VSSCORE IOVDD_2/VSSCORE IOVSS_2/VSSCORE IOVDD_3/VSSCORE IOVSS_3/VSSCORE PAD_CLK/VSSCORE PAD_RSTN/VSSCORE PAD_URX/VSSCORE PAD_MISO/VSSCORE PAD_UTX/VSSCORE PAD_SCLK/VSSCORE PAD_MOSI/VSSCORE PAD_CS/VSSCORE PAD_SDA/VSSCORE PAD_SCL/VSSCORE PAD_GPIO_0/VSSCORE PAD_GPIO_1/VSSCORE PAD_GPIO_2/VSSCORE PAD_GPIO_3/VSSCORE PAD_GPIO_4/VSSCORE PAD_GPIO_5/VSSCORE PAD_GPIO_6/VSSCORE PAD_GPIO_7/VSSCORE}
connect_supply_net VDDPAD -ports {VDD_0/VDDPAD VSS_0/VDDPAD IOVDD_0/VDDPAD IOVSS_0/VDDPAD IOVDD_1/VDDPAD IOVSS_1/VDDPAD VDD_2/VDDPAD VSS_2/VDDPAD IOVDD_2/VDDPAD IOVSS_2/VDDPAD IOVDD_3/VDDPAD IOVSS_3/VDDPAD PAD_CLK/VDDPAD PAD_RSTN/VDDPAD PAD_URX/VDDPAD PAD_MISO/VDDPAD PAD_UTX/VDDPAD PAD_SCLK/VDDPAD PAD_MOSI/VDDPAD PAD_CS/VDDPAD PAD_SDA/VDDPAD PAD_SCL/VDDPAD PAD_GPIO_0/VDDPAD PAD_GPIO_1/VDDPAD PAD_GPIO_2/VDDPAD PAD_GPIO_3/VDDPAD PAD_GPIO_4/VDDPAD PAD_GPIO_5/VDDPAD PAD_GPIO_6/VDDPAD PAD_GPIO_7/VDDPAD}
